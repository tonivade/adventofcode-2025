; https://adventofcode.com/2025/day/2

(import java.lang.String trim)
(import java.lang.Long parseLong 1)

(load-file "mal/aoc.mal")

(defn split-pair [s] 
    (map Long.parseLong/1 (split (String.trim s) "-"))
)

(defn parse [file]
    (let* [input (slurp file)]
        (map split-pair (split input ","))
    )
)

(defn is-repeated? [s]
    (let* [i (/ (count s) 2)]
        (= (substring s 0 i) (substring s i (count s)))
    )
)

(defn is-invalid? [number]
    (let* [s (str number)]
        (and (zero? (% (count s) 2)) (is-repeated? s))
    )
)

(defn unfold1 [r]
    (filter is-invalid? (range (first r) (incr (second r))))
)

(defn unfold1-sum [r] (sum (unfold1 r)))

(defn all-the-same? [xs]
    (if (empty? xs)
        true
        (let* [frst (first xs)]
            (for-all? (fn* [item] (= item frst)) xs)
        )
    )
)

(defn expand [input]
    (if (> (count input) 1)
        (let* [end (/ (count input) 2)]
            (map (fn* [s] (map join-to-string (chunks input s))) (range 1 (incr end)))
        )
        ()
    )
)

(defn is-repeated2? [input]
    (not 
        (empty?
            (filter all-the-same? (expand (seq input)))
        )
    )
)

(defn is-invalid2? [number]
    (let* [s (str number)] (is-repeated2? s))
)

(defn unfold2 [r]
    (filter is-invalid2? (range (first r) (incr (second r))))
)

(defn unfold2-sum [r] (sum (unfold2 r)))

(def! input (if-defined DEBUG-EVAL "input/day2-test.txt" "input/day2.txt"))

; part1
(println
    (timed!
        (sum (parallel-map unfold1-sum (parse input)))
    )
)

; part2
(println
    (timed!
        (sum (parallel-map unfold2-sum (parse input)))
    )
)