; https://adventofcode.com/2025/day/9

(import java.lang.Math abs 1)

(load-file "mal/aoc.mal")
(load-file "mal/matrix.mal")

(def! file (if-defined DEBUG-EVAL "input/day9-test.txt" "input/day9.txt"))

(defn area [p q]
    (let* 
        [
            l1 (abs (- (first p) (first q)))
            l2 (abs (- (second p) (second q)))
        ]
        (* (incr l1) (incr l2))
    )
)

(defn bounds [p q]
    (let* 
        [
            minX (min-val (first p) (first q))
            maxX (max-val (first p) (first q))
            minY (min-val (second p) (second q))
            maxY (max-val (second p) (second q))
        ]
        (list
            (list minX minY)
            (list minX maxY)
            (list maxX maxY)
            (list maxX minY)
        )
    )
)

(defn cross [a b c]
    (let*
        [
            x (- (first b) (first a))
            y (- (second c) (second a))
            z (- (second b) (second a))
            w (- (first c) (first a))
        ]
        (- (* x y) (* z w))
    )
)

(defn on-segment? [a b c]
    (let*
        [
            x (<= (min-val (first a) (first c)) (first b))
            y (<= (first b) (max-val (first a) (first c)))
            z (<= (min-val (second a) (second c)) (second b))
            w (<= (second b) (max-val (second a) (second c)))
        ]
        (and x y z w)
    )
)

(defn on-edge? [p edges]
    (exists? 
        (fn* [edge]
            (let*
                [
                    a (first edge)
                    b (second edge)
                ]
                (and (= (cross a p b) 0) (on-segment? a p b))
            )
        )
        edges
    )
)

(defn inside? [p edges]
    (reduce
        false
        (fn* [acc edge] 
            (let* 
                [
                    a (first edge)
                    b (second edge)
                    x (not (= (> (second a) (second p)) (> (second b) (second p))))
                    y (= (< (cross a b p) 0) (> (second b) (second a)))
                    intersects (and x y)
                ]
                (xor intersects acc)
            )
        )
        edges
    )
)

(defn in-polygon? [p edges] (or (on-edge? p edges) (inside? p edges)))

(defn intersects-edge? [p1 q1 p2 q2]
    (let* 
        [
            d1 (cross p1 q1 p2)
            d2 (cross p1 q1 q2)
            d3 (cross p2 q2 p1)
            d4 (cross p2 q2 q1)
        ]
        (and
            (or
                (and (> d1 0) (< d2 0))
                (and (< d1 0) (> d2 0))
            )
            (or
                (and (> d3 0) (< d4 0))
                (and (< d3 0) (> d4 0))
            )
        )
    )
)

(defn intersects? [bounds edges]
    (exists?
        (fn* [r] 
            (let* 
                [r1 (first r) r2 (second r)]
                (exists?
                    (fn* [p]
                        (let*
                            [p1 (first p) p2 (second p)]
                            (intersects-edge? r1 r2 p1 p2) 
                        )
                    )
                    edges
                )
            )
        )
        bounds
    )
)

(defn contains-rectangle? [polygon rectangle]
    (let*
        [
            edges (zip-list polygon (append (rest polygon) (first polygon))) 
            bounds (zip-list rectangle (append (rest rectangle) (first rectangle)))
            in-polygon? (for-all? (fn* [p] (in-polygon? p edges)) rectangle)
        ]
        (and in-polygon? (not (intersects? bounds edges)))
    )
)

(println
    (timed!
        (let* [points (parse-points file)]
            (max 
                (map 
                    (fn* [pair] (area (first pair) (second pair))) 
                    (combinations2 points)
                )
            )
        )
    )
)

(println
    (timed!
        (let* [points (parse-points file)]
            (max 
                (map 
                    (fn* [pair] (area (first pair) (second pair))) 
                    (filter 
                        (fn* [pair]
                            (let*
                                [p (first pair) q (second pair)]
                                (contains-rectangle? points (bounds p q))
                            )
                        )
                        (combinations2 points)
                    )
                )
            )
        )
    )
)
