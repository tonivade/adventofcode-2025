; https://adventofcode.com/2025/day/8

(import java.lang.Integer parseInt 1)
(import java.lang.Math pow 2)
(import java.lang.Math sqrt 1)

(load-file "mal/aoc.mal")

(defn distance3d [this other]
    (let* 
        [
            a (Math.pow/2 (- (first this) (first other)) 2)
            b (Math.pow/2 (- (second this) (second other)) 2)
            c (Math.pow/2 (- (last this) (last other)) 2)
            s (+ a (+ b c))
        ]
        (Math.sqrt/1 s)
    )
)

(defn parse [file]
    (let* [input (lines file)]
        (map (fn* [line] (map Integer.parseInt/1 (split line ","))) input)
    )
)

(defn make-connections [points]
    (sort-list-by 
        (fn* [a b] (< (distance3d (first a) (second a)) (distance3d (first b) (second b))))
        (combinations2 points)
    )
)

(defn to-key [p] (str (first p) "," (second p) "," (last p)))

(defn merge [circuits p q]
    (let*
        [
            indexP (index-where circuits (fn* [group] (set-contains? group (to-key p))))
            indexQ (index-where circuits (fn* [group] (set-contains? group (to-key q))))
            union (set-union (nth circuits indexP) (nth circuits indexQ))
            new-circuits 
                (map first 
                    (filter 
                        (fn* [item] (and (not (= (second item) indexP)) (not (= (second item) indexQ)))) 
                        (zip-with-index circuits)
                    )
                )
        ]
        (append new-circuits union)
    )
)

(defn connect [points connections]
    (reduce
        (fn* [circuits pair] (merge circuits (first pair) (second pair)))
        (map (fn* [p] (set-from-list (list (to-key p)))) points)
        connections
    )
)

(defn connect2 [points connections]
    (first 
        (reduce
            (fn* [acc pair] 
                (list 
                    (if (= (count (second acc)) 1) 
                        (first acc) 
                        pair
                    ) 
                    (merge (second acc) (first pair) (second pair)))
            )
            (list () (map (fn* [p] (set-from-list (list (to-key p)))) points))
            connections
        )
    )
)

(def! input (get-input 8))
(def! max-connections (if-defined DEBUG-EVAL 10 1000))

(println
    (timed!
        (let* 
            [
                points (parse input)
                connections (take max-connections (make-connections points))
                groups (map set-to-list (connect points connections))
            ]
            (mul (take 3 (reverse (sort-list (map count groups)))))
        )
    )
)

(println
    (timed!
        (let* 
            [
                points (parse input)
                connections (make-connections points)
                last-point (connect2 points connections)
            ]
            (* (first (first last-point)) (first (second last-point)))
        )
    )
)