(load-file "mal/aoc.mal")

(import java.net.http.HttpRequest newBuilder)
(import java.net.http.HttpClient newBuilder)
(import java.net.http.HttpResponse$BodyHandlers ofString)
(import java.time.Duration ofSeconds 1)
(import java.net.URI create 1)
(import java.nio.file.Files writeString 3)

(defn new-client []
    (->
        (HttpClient.newBuilder)
        (.version "HTTP_1_1")
        (.followRedirects "NORMAL")
        (.connectTimeout (Duration.ofSeconds/1 10))
        (.build)
    )
)

(defn set-headers [builder headers]
    (if (empty? headers)
        builder
        (let* [key (first (keys headers)) value (get headers key)]
            (do 
                (.setHeader builder key value)
                (set-headers builder (dissoc headers key))
            )
        )
    )
)

(defn new-request [uri headers]
    (->
        (HttpRequest.newBuilder)
        (.GET)
        (.uri (URI.create/1 uri))
        (.timeout (Duration.ofSeconds/1 10))
        (set-headers headers)
        (.build)
    )
)

(defn http-get [uri headers]
    (let* [client (new-client) request (new-request uri headers)]
        (.send client request (HttpResponse$BodyHandlers.ofString))
    )
)

(defn aoc-get [year day session]
    (let* 
        [
            response 
                (http-get 
                    (str "https://adventofcode.com/" year "/day/" day "/input") 
                    (assoc {} "Cookie" (str "session=" session))
                )
        ]
        (if (= (.statusCode response) 200)
            (.body response)
            (throw (str "download error " (.statusCode response)))
        )
    )
)

(defn download-file [year day session]
    (let* 
        [
            file-name (str "input/day" day ".txt")
            file (new java.io.File file-name)
        ]
        (if (.exists file)
            (do
                (println "file exists" file-name)
                (slurp file-name)
            )
            (do
                (let* [content (aoc-get year day session)]
                    (Files.writeString/3 (.toPath file) content ())
                )
                (println "file saved" file-name)
                content
            )
        )
    )
)

(defn download-day [day]
    (let* [ props (read-properties ".env") ]
        (download-file (get props "year") day (get props "session_id"))
    )
)

(defn get-input [day]
    (if-defined DEBUG-EVAL 
        (do (println "using test file for day" day) (slurp (str "input/day" day "-test.txt"))) 
        (download-day day)
    )
)