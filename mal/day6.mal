; https://adventofcode.com/2025/day/6

(import java.lang.Long parseLong 1)

(load-file "mal/aoc.mal")

(defn parse1 [file]
    (let* [input (lines file)]
        (->>
            (group-by-map 
                second
                first
                (mapcat 
                    zip-with-index
                    (map 
                        (fn* [line] (.split line "\\s+"))
                        (map .trim input)
                    )
                )
            )
            (vals)
        )
    )
)

(defn parse-line [line cols]
    (map 
        (fn* [window] 
            (let* [start (first window) end (decr (second window))]
                (substring line start end)
            )
        )
        cols
    )
)

(defn columns [row]
    (sliding2
        (reduce
            (fn* [acc item] (append acc (+ (last acc) item)))
            (list 0)
            (map (combine incr count) (rest (.split (str row " ") "[\\*\\+]")))
        )
    )
)

(defn parse2 [file]
    (let* [input (lines file) cols (columns (last input))]
        (->>
            (group-by-map
                second
                first
                (mapcat
                    zip-with-index
                    (map 
                        (fn* [line] (parse-line line cols))
                        input
                    )
                )
            )
            (vals)
        )
    )
)

(defn transform [col]
    (let* [op (.trim (first col)) numbers (rest col)]
        (cons
            op
            (map 
                .trim
                (map 
                    join-to-string
                    (vals
                        (group-by-map
                            second
                            first
                            (mapcat zip-with-index (map seq numbers))
                        )
                    )
                )
            )
        )
    )
)

(defn solve (input)
    (let* [op (first input) values (map Long.parseLong/1 (rest input))]
        (cond 
            (= op "+") (sum values)
            (= op "*") (mul values)
        )
    )
)

(def! input (get-input 6))

(println 
    (timed! 
        (reduce 
            (fn* [acc x] (+ acc (solve x)))
            0
            (parse1 input)
        )
    )
)

(println 
    (timed! 
        (reduce 
            (fn* [acc x] (+ acc (solve (transform x))))
            0
            (parse2 input)
        )
    )
)