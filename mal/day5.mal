; https://adventofcode.com/2025/day/5

(import java.lang.Long parseLong 1)

(load-file "mal/aoc.mal")

(defn to-range (input)
    (map Long.parseLong/1 (split input "-"))
)

(defn parse [file]
    (let* 
        [
            input (.split file "\n\n")
            ranges (first input) 
            products (second input)
        ]
        (list (map to-range (lines ranges)) (map Long.parseLong/1 (lines products)))
    )
)

(defn in-range [range num]
   (and (>= num (first range)) (<= num (second range)))
)

(defn range-size [range]
    (incr (- (second range) (first range)))
)

(defn overlaps [left right]
    (and (>= (second left) (first right)) (<= (first left) (second right)))
)

(defn merge [left right]
    (list 
        (if (< (first left) (first right)) (first left) (first right))
        (if (> (second left) (second right)) (second left) (second right))
    )
)

(defn is-fresh [ranges product]
    (exists?
        (fn* [r] (in-range r product))
        ranges
    )
)

(defn count-fresh [ranges products]
    (reduce
        (fn* 
            [acc p] 
            (if (is-fresh ranges p) (incr acc) acc)
        )
        0
        products
    )
)

(defn sort-ranges [ranges]
    (sort-list-by (fn* [a b] (< (first a) (first b))) ranges)
)

(defn merge-ranges [ranges]
    (reduce 
        (fn* [acc range] 
            (let* 
                [i (index-where acc (fn* [r] (overlaps range r)))]
                (if (nil? i)
                    (sort-ranges (cons range acc))
                    (replace-nth acc i (merge (nth acc i) range))
                )
            )
        )
        ()
        (sort-ranges ranges)
    )
)

(def! input (get-input 5))

(println 
    (timed! 
        (let* [parsed (parse input)]
            (count-fresh (first parsed) (second parsed))
        )
    )
)

(println 
    (timed! 
        ; for some reason, the merge algorithm is not merging some ranges and I have to apply twice
        (let* [ranges (merge-ranges (merge-ranges (first (parse input))))]
            (reduce
                (fn* [acc r] (+ acc (range-size r)))
                0
                ranges
            )
        )
    )
)