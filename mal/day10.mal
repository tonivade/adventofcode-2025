; https://adventofcode.com/2025/day/10

(import java.lang.String lines)
(import java.lang.String trim)
(import java.lang.String length)
(import java.lang.String split 1)
(import java.lang.String substring 2)
(import java.lang.Integer parseInt 1)

(load-file "mal/aoc.mal")

(def! input (if-defined DEBUG-EVAL "input/day10-test.txt" "input/day10.txt"))

(defn all-combinations [size]
    (let* [xs (range 0 size)]
        (lazy-seq
            (mapcat (fn* [k] (combinations k xs)) (range 1 (incr size)))
        )
    )
)

(defn all-patterns [size]
    (mapcat
        (fn* [bs]
            (cons bs
                (map (fn* [b] (append bs b))
                    (range 0 size))))
        (all-combinations size)
    )
)

(defn parse-machine [line]
    (let* 
        [
            splitted (split line " ")
            ls (first splitted)
            bs (drop-last (rest splitted)) 
            js (last splitted)
            lights (map (fn* [l] (= l "#")) (seq (substring ls 1 (decr (length ls)))))
            jolts (map parseInt (split (substring js 1 (decr (length js))) ","))
            buttons (map (fn* [b] (map parseInt (split (substring b 1 (decr (length b))) ","))) bs)
        ]
        (list lights buttons jolts)
    )
)

(defn click [presses light-count]
    (reduce 
        (fn* [acc p] (replace-nth acc p (not (nth acc p)))) 
        (map (fn* [i] false) (range 1 (incr light-count))) 
        (apply concat presses)
    )
)

(defn turn-on [machine]
    (let*
        [
            lights (first machine)
            buttons (second machine)
            patterns 
                (map 
                    (fn* [bs] (map (fn* [i] (nth buttons i)) bs)) 
                    (all-combinations (count buttons))
                )
        ]
        (count 
            (nth
                patterns
                (index-where patterns (fn* [p] (= lights (click p (count lights)))))
            )
        )
    )
)

(defn odd-indices [lights]
    (map second (filter first (zip-with-index lights)))
)

(defn calculate-patterns [buttons light-count]
    (group-by-map 
        (fn* [pair] (odd-indices (first pair)))
        second
        (map 
            (fn* [bs] 
                (list (click bs light-count) bs)
            ) 
            (map 
                (fn* [bs] 
                    (map (fn* [i] (nth buttons i)) bs)
                ) 
                (all-patterns (count buttons))
            )
        )
    )
)

(defn simulate-click [target presses]
    (reduce
        (fn* [current b] 
            (replace-nth current b (decr (nth current b)))
        )
        target
        (apply concat presses)
    )
)

(defn get-min-presses [patterns target]
    (let*
        [min-presses 
            (memoize 
                (fn* [current] 
                    (if (for-all? zero? current)
                        0
                        (let* 
                            [
                                indicators (odd-indices (map odd? current))
                                all-presses (get patterns (str indicators))
                            ]
                            (if (nil? all-presses)
                                nil
                                (min
                                    (filter
                                        (fn* [i] (not (nil? i)))
                                        (map 
                                            (fn* [presses] 
                                                (let* [target-after (simulate-click current presses)]
                                                    (if (exists? neg? target-after)
                                                        nil
                                                        (let* 
                                                            [
                                                                half (fn* [i] (/ i 2))
                                                                half-target (map half target-after)
                                                                next-min-presses (min-presses half-target)
                                                            ]
                                                            (if (nil? next-min-presses)
                                                                nil
                                                                (+ (* next-min-presses 2) (count presses))
                                                            )
                                                        )
                                                    )
                                                )
                                            ) 
                                            all-presses
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        ]
        (min-presses target)
    )
    
)

(defn jolt-on [machine]
    (let*
        [
            lights (first machine)
            buttons (second machine)
            jolts (last machine)
            patterns (calculate-patterns buttons (count lights))
        ]
        (get-min-presses patterns jolts)
    )
)

(defn parse [file]
    (let* [input (lines (slurp file))]
        (map parse-machine input)
    )
)

(println
    (timed!
        (sum (map turn-on (parse input)))
    )
)

(println
    (timed!
        (sum (map jolt-on (parse input)))
    )
)
