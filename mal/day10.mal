; https://adventofcode.com/2025/day/10

(import java.lang.String lines)
(import java.lang.String trim)
(import java.lang.String length)
(import java.lang.String split 1)
(import java.lang.String substring 2)
(import java.lang.Integer parseInt 1)

(load-file "mal/aoc.mal")

(def! input (if-defined DEBUG-EVAL "input/day10-test.txt" "input/day10.txt"))

(defn all-combinations [size]
    (let*
        (xs (generate 0 (decr size)))
        (flatten (map (fn* [k] (combinations k xs)) (generate 1 size)))
    )
)

(defn all-patterns [size]
    (let* (base (all-combinations size))
        (concat base
            (flatten
                (map
                    (fn* [bs] (map (fn* [b] (append bs b)) (generate 0 (decr size))))
                    base
                )
            )
        )
    )
)

(defn parse-machine [line]
    (let* 
        (
            splitted (split line " ")
            ls (first splitted)
            bs (drop-last (rest splitted)) 
            js (last splitted)
            lights (map (fn* [l] (= l "#")) (seq (substring ls 1 (- (length ls) 1))))
            jolts (map parseInt (split (substring js 1 (- (length js) 1)) ","))
            buttons (map (fn* [b] (map parseInt (split (substring b 1 (- (length b) 1)) ","))) bs)
        )
        (list lights buttons jolts)
    )
)

(defn click [pattern light-count]
    (reduce 
        (map (fn* [i] false) (generate 1 light-count)) 
        (fn* [acc p] (replace-nth acc p (not (nth acc p)))) 
        (flatten pattern)
    )
)

(defn turn-on [machine]
    (let*
        (
            lights (first machine)
            buttons (second machine)
            patterns 
                (map 
                    (fn* [bs] 
                        (map (fn* [i] (nth buttons i)) bs)
                    ) 
                    (all-combinations (count buttons))
                )
        )
        (count 
            (nth
                patterns
                (index-where patterns (fn* [p] (= lights (click p (count lights)))))
            )
        )
    )
)

(defn odd-indices [lights]
    (map second (filter (fn* [item] (first item) )(zip-with-index lights)))
)

(defn calculate-patterns [buttons light-count]
    (group-by 
        (fn* [pair] (odd-indices (first pair)))
        (map 
            (fn* [p] (list (click p light-count) p)) 
            (map 
                (fn* [bs] 
                    (map (fn* [i] (nth buttons i)) bs)
                ) 
                (all-patterns (count buttons))
            )
        )
    )
)

(defn simulate-click [target buttons presses]
    (reduce
        target
        (fn* [current p] 
            (reduce 
                current
                (fn* [xs b] (replace-nth xs b (decr (nth xs b))))
                (peek (nth buttons p)))
        )
        presses
    )
)

(defn get-min-presses [patterns buttons target]
    (if (for-all? (fn* [item] (= item 0)) target)
        0
        (let* 
            (
                indicators (odd-indices (map (fn* [i] (= 1 (% i 2))) target))
                presses (get patterns (str indicators))
            )
            (map (fn* [p] (simulate-click (peek target) (peek buttons) (peek p))) presses)
        )
    )
)

(defn jolt-on [machine]
    (let*
        (
            lights (first machine)
            buttons (second machine)
            jolts (last machine)
            patterns (peek (calculate-patterns buttons (count lights)))
        )
        (get-min-presses patterns buttons jolts)
    )
)

(defn parse [file]
    (let* (input (lines (slurp file)))
        (map parse-machine input)
    )
)

(println
    (timed!
        (sum (map turn-on (parse input)))
    )
)

(println
    (timed!
        (map jolt-on (parse input))
    )
)
