; https://adventofcode.com/2025/day/12

(import java.lang.String lines)
(import java.lang.String trim)
(import java.lang.String split 1)
(import java.lang.Integer parseInt 1)

(load-file "mal/aoc.mal")

(def! file (if-defined DEBUG-EVAL "input/day12-test.txt" "input/day12.txt"))

(defn parse-present [input]
    (let* 
        [
            all-lines (lines input)
            id (first (split (first all-lines) ":"))
            area (count (filter (fn* [item] (= item "#")) (apply concat (map seq (rest all-lines)))))
        ]
        (list id area)
    )
)

(defn parse-tree [line]
    (let* 
        [
            parsed (map trim (split line ":"))
            dimensions (map parseInt (split (first parsed) "x"))
            presents (map parseInt (split (second parsed) " "))
        ]
        (list dimensions presents)
    )
)

(defn total-area [tree]
    (let* [dimensions (first tree)]
        (* (first dimensions) (second dimensions))
    )
)

(defn required-area [tree presents]
    (reduce 
        (fn* [acc pair]
            (+ acc (* (first pair) (get presents (str (second pair)))))
        )
        0
        (zip-with-index (second tree))
    )
)

(println
    (timed!
        (let* 
            [
                input (split (slurp file) "\n\n")
                presents (list-to-map (map parse-present (drop-last input)))
                trees (map parse-tree (lines (last input)))
            ]
            (count (filter (fn* [tree] (>= (total-area tree) (required-area tree presents))) trees))
        )
    )
)
