;; advent of code utility methods

(load-file "mal/lib.mal")
(load-file "mal/http.mal")

(defn aoc-get [year day session]
    (let* 
        [
            response 
                (http-get 
                    (str "https://adventofcode.com/" year "/day/" day "/input") 
                    (assoc {} "Cookie" (str "session=" session))
                )
        ]
        (if (= (.statusCode response) 200)
            (.body response)
            (throw (str "download error " (.statusCode response)))
        )
    )
)

(defn download-file [year day session]
    (let* 
        [
            file-name (str "input/day" day ".txt")
            file (new java.io.File file-name)
        ]
        (if (.exists file)
            (do
                (println "file exists" file-name)
                (slurp file-name)
            )
            (let* [content (aoc-get year day session)]
                (do
                    (Files.writeString/3 (.toPath file) content ())
                    (println "file saved" file-name)
                    content
                )
            )
        )
    )
)

(defn download-day [day]
    (let* [ props (read-properties ".env") ]
        (download-file (get props "year") day (get props "session_id"))
    )
)

(defn get-input [day & part]
    (if-defined DEBUG-EVAL 
        (do 
            (println "using test file for day" day (if (empty? part) "" (str "part " (first part))))
            (slurp (str "input/day" day "-test" (if (empty? part) "" (first part)) ".txt"))
        ) 
        (download-day day)
    )
)