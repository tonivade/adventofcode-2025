; https://adventofcode.com/2025/day/11

(import java.lang.String lines)
(import java.lang.String trim)
(import java.lang.String split 1)

(load-file "mal/aoc.mal")

(def! input1 (if-defined DEBUG-EVAL "input/day11-test1.txt" "input/day11.txt"))
(def! input2 (if-defined DEBUG-EVAL "input/day11-test2.txt" "input/day11.txt"))

(defn parse-line [line]
    (let* 
        [
            splitted (map trim (split line ":"))
            node (first splitted)
            connections (split (second splitted) " ")
        ]
        (list node connections)
    )
)

(defn parse [file]
    (let* [input (lines (slurp file))]
        (list-to-map (map parse-line input))
    )
)

(defn find-all-paths [graph start end]
    (let* 
        [dfs 
            (memoize
                (fn* [current]
                    (let*
                        [connections (get graph current)]
                        (if (nil? connections)
                            0
                            (->>
                                connections
                                (map
                                    (fn* [output] 
                                        (if (= output end)
                                            1
                                            (dfs output)
                                        )
                                    )
                                )
                                (sum)
                            )
                        )
                    )
                )
            )
        ]
        (dfs start)
    )
)

(println
    (timed!
        (find-all-paths (parse input1) "you" "out")
    )
)

(println
    (timed!
        (let* 
            [
                servers (parse input2)
                svr-to-fft (find-all-paths servers "svr" "fft")
                fft-to-dac (find-all-paths servers "fft" "dac")
                dac-to-out (find-all-paths servers "dac" "out")
            ]
            (mul (list svr-to-fft fft-to-dac dac-to-out))
        )
    )
)